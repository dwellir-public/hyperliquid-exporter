# systemd EnvironmentFile syntax, not a shell script.
CHAIN=mainnet
# Defaults match the Hyperliquid charm. The charm writes its actual runtime paths.
NODE_HOME=/home/hyperliquid/hl
NODE_BINARY=/home/hyperliquid/hl-node
BINARY_HOME=/home/hyperliquid
# Optional peer monitoring writes here, independently of NODE_HOME.
EXPORTER_STATE_DIR=/var/lib/hyperliquid-exporter
# Example: EXPORTER_ARGS="--evm-metrics --replica-metrics --peer-latency"
EXPORTER_ARGS=
